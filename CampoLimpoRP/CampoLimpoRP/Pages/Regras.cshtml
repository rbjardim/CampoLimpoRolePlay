<script>
    function toggleMenu(id) {
        const menu = document.getElementById(id);
        menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

        function loadPartial(url) {
        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error("Erro ao carregar conteúdo");
                }
                return response.text();
            })
            .then(html => {
                document.getElementById("contentArea").innerHTML = html;

                if (window.updateBookPages) {
                    bookCurrentPage = 0;
                    updateBookPages();
                }
            })
            .catch(error => {
                document.getElementById("contentArea").innerHTML =
                    "<p>Erro ao carregar o conteúdo.</p>";
                console.error(error);
            });
    }

        function normalizeText(text) {
        return text
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .trim();
    }

    function searchRule() {
        const query = normalizeText(document.getElementById("searchRule").value);
        const content = document.getElementById("contentArea");
        const links = document.querySelectorAll(".submenu a");
        let found = false;

        for (const link of links) {
            const text = normalizeText(link.textContent);

            if (text.includes(query)) {
                const onclickAttr = link.getAttribute("onclick");

                if (onclickAttr.includes("loadPartial")) {
                    const url = onclickAttr.match(/'([^']+)'/)[1];
                    loadPartial(url);
                } else if (onclickAttr.includes("loadContent")) {
                    const section = onclickAttr.match(/'([^']+)'/)[1];
                    loadContent(section);
                }

                found = true;
                break;
            }
        }

        if (!found) {
            content.innerHTML = "<p>Nenhuma regra encontrada para sua busca.</p>";
        }
    }

    function liberarMenuPolicia() {
        const params = new URLSearchParams(window.location.search);

        if (params.get("policia") === "1530528") {
            document.getElementById("menuPolicia").style.display = "block";
        }
    }

    liberarMenuPolicia();

    let bookCurrentPage = 0;

    window.nextPage = function () {

        console.log('CLICK NEXT');

        const pages = document.querySelectorAll('#contentArea .book-page');

        console.log('pages found:', pages.length);

        if (!pages.length) return;

        if (bookCurrentPage < pages.length - 1) {
            bookCurrentPage++;
            updateBookPages();
        }
    };

    window.prevPage = function () {

        console.log('CLICK PREV');

        const pages = document.querySelectorAll('#contentArea .book-page');

        console.log('pages found:', pages.length);

        if (!pages.length) return;

        if (bookCurrentPage > 0) {
            bookCurrentPage--;
            updateBookPages();
        }
    };

    window.updateBookPages = function () {

        const pages = document.querySelectorAll('#contentArea .book-page');
        const indicator = document.getElementById('pageIndicator');

        pages.forEach((page, index) => {
            page.classList.toggle('active', index === bookCurrentPage);
        });

        if (indicator) {
            indicator.innerText =
                `Página ${bookCurrentPage + 1} de ${pages.length}`;
        }
    };

        function abrirCodigoPenal(query) {
        document.getElementById("gerais").style.display = "block";

        document.getElementById("subCodigoPenal").style.display = "block";

        if (query) {
            loadPartial(`/SubMenus/RegrasGerais/CodigoPenal/${query}`);
        } else {
            loadPartial('/SubMenus/RegrasGerais/CodigoPenal/contravida');
        }
    }

    function verificarQueryParams() {
        const params = new URLSearchParams(window.location.search);

        if (params.get("policia") === "1530528") {
            document.getElementById("menuPolicia").style.display = "block";
        }

        const codigoPenal = params.get("codigopenal") || params.get("codigoPenal");

        if (codigoPenal !== null) {
            abrirCodigoPenal(codigoPenal === "112512" ? "contravida" : codigoPenal);
        }
    }

    verificarQueryParams();

</script>

