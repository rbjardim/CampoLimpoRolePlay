@page
@model CampoLimpoRP.Pages.RegrasModel
@{
    ViewData["Title"] = "Regras";
}

<div class="layout-container">
    <aside class="sidebar">
        <div class="menu-item search-container">
            <div class="search-wrapper">
                <input type="text"
                       id="searchRule"
                       placeholder="Busque a regra..."
                       onkeypress="if(event.key === 'Enter') searchRule()"
                       class="search-input" />
                <span class="search-icon" onclick="searchRule()">🔍</span>
            </div>
        </div>

        <div class="menu-item">
            <button class="menu-btn" onclick="toggleMenu('gerais')">
                Regras Gerais
            </button>
            <div id="gerais" class="submenu">
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasGerais')">Regras Gerais</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasBasicas')">Regras Básicas</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasBomSenso')">Regras de Bom Senso</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasMulheres')">Regras Mulheres</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasAdvertencia')">Regras Advertência</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasTicket')">Regras Ticket</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasTicket')">Regras Denuncia</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasTicket')">Regras Personagem</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasGerais/RegrasArmas')">Regras Armas</a>
            </div>
        </div>

        <div class="menu-item">
            <button class="menu-btn" onclick="toggleMenu('ilegal')">
                Regras Ilegal
            </button>
            <div id="ilegal" class="submenu">
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasGeraisI')">Regras Gerais</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasFaccoes')">Regras de Facções</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasPD')">Regras PD</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasCobranca')">Regras Ação de Cobrança</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasFarm')">Regras de Farm</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasDrogas')">Vendas de Drogas</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasIlegal/RegrasLoot')">Regras de Loot</a>
            </div>
        </div>

        <div class="menu-item">
            <button class="menu-btn" onclick="toggleMenu('racoes')">
                Regras Ações
            </button>
            <div id="racoes" class="submenu">
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasGeraisA')">Regras Gerais</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasFuga')">Regras de Fugas e Perseguição</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasAbordagem')">Abordagens Policiais</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasSAP')">Resgate a prisioneiros e SAP</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasSequestro')">Regras de Sequestro</a>
                <a href="#" onclick="loadPartial('/SubMenus/RegrasAcoes/RegrasCorrida')">Corrida ilegal</a>
            </div>
        </div>

        <div class="menu-item">
            <button class="menu-btn" onclick="toggleMenu('acoes')">
                Ações
            </button>
            <div id="acoes" class="submenu">
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasRua')">Ações de Rua e Assalto</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasCaixa')">Caixa Eletrônico</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasResidencia')">Roubo a Residência</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasDP')">Invasão a DP</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasCarroForte ')">Carro Forte</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasBlipados')">Ações Blipadas</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasSequestroA')">Sequestro para Ação</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasSequestroR')">Sequestro Relâmpago</a>
                <a href="#" onclick="loadPartial('/SubMenus/Acoes/RegrasComboio')">Ação Comboio</a>
            </div>
        </div>
    </aside>

    <main class="content" id="contentArea">
        <h1>Selecione a Regra que deseja ler!</h1>
        <p>Leia com atenção todos as linhas para que seja feito um RP de Qualidade.</p>
    </main>
</div>

<script>
    function toggleMenu(id) {
        const menu = document.getElementById(id);
        menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

    function loadPartial(url) {
        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error("Erro ao carregar conteúdo");
                }
                return response.text();
            })
            .then(html => {
                document.getElementById("contentArea").innerHTML = html;
            })
            .catch(error => {
                document.getElementById("contentArea").innerHTML =
                    "<p>Erro ao carregar o conteúdo.</p>";
                console.error(error);
            });
    }

        function normalizeText(text) {
        return text
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .trim();
    }

    function searchRule() {
        const query = normalizeText(document.getElementById("searchRule").value);
        const content = document.getElementById("contentArea");
        const links = document.querySelectorAll(".submenu a");
        let found = false;

        for (const link of links) {
            const text = normalizeText(link.textContent);

            if (text.includes(query)) {
                const onclickAttr = link.getAttribute("onclick");

                if (onclickAttr.includes("loadPartial")) {
                    const url = onclickAttr.match(/'([^']+)'/)[1];
                    loadPartial(url);
                } else if (onclickAttr.includes("loadContent")) {
                    const section = onclickAttr.match(/'([^']+)'/)[1];
                    loadContent(section);
                }

                found = true;
                break;
            }
        }

        if (!found) {
            content.innerHTML = "<p>Nenhuma regra encontrada para sua busca.</p>";
        }
    }
</script>

