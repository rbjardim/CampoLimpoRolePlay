@page
@{
    Layout = null;
}

<div style="color:#fff;">
    <h1><strong>Código Penal Campo Limpo Roleplay</strong></h1>
    <p>
        <div class="tabela-container">

            <div class="tabela-titulo">
                INCISOS
            </div>

            <table class="tabela-crimes">
                <thead>
                    <tr>
                        <th>INCISO</th>
                        <th>DESCRIÇÃO</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>INCISO I</td>
                        <td>SERÁ EQUIPARADO AO MESMO CRIME O CÚMPLICE OU A PARTICIPAÇÃO DE OUTRA PESSOA NO ATO CRIMINOSO.</td>
                    </tr>

                    <tr>
                        <td>INCISO II</td>
                        <td>PODERÁ CONSTITUIR DEFESA TODA E QUALQUER PESSOA PRESA OU CONDUZIDA AO DISTRITO POLICIAL.</td>
                    </tr>

                    <tr>
                        <td>INCISO III</td>
                        <td>SERÁ REDUZIDO O TEMPO DE 30% a 50% DOS PRESOS REINCIDENTES, E DE 50% DO RÉU PRIMÁRIO.</td>
                    </tr>

                    <tr>
                        <td>INCISO IV</td>
                        <td>EM ABORDAGENS A PESSOAS DO SEXO FEMININO, PODERÁ O POLICIAL DO SEXO MASCULINO REALIZAR PROCEDIMENTO DE REVISTA NA AUSÊNCIA DE POLICIAL FEMININA.</td>
                    </tr>

                    <tr>
                        <td>INCISO V</td>
                        <td>CRIMES COMETIDOS POR POLICIAIS DEVERÁ SER ACIONADO O SEU COMANDANTE IMEDIATO PARA QUE ESTE REALIZE OS TRÂMITES INTERNOS CONFORME OS REGIMENTOS.</td>
                    </tr>

                    <tr>
                        <td colspan="2" style="text-align:center;">
                            <strong>ESCRITO SEM CUNHO E EQUIPARAÇÃO COM A REALIDADE, APENAS PARA O SEGUIMENTO DE JOGO GTA-V FIVEM.</strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
</div>
