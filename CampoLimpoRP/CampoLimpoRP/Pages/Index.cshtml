@page
@model IndexModel
@{
    ViewData["Title"] = "Campo Limpo Roleplay®";
}

<div class="index-container">
    <h1 class="display-4">
        Bem-Vindo
    </h1>

    <p>
        <i>
            <span class="text-decoration-underline">
                Regras vigentes para o ano de 2026.
            </span>
        </i>
    </p>

    <div class="mt-4">
        <a asp-page="/Regras" class="btn btn-primary btn-lg btn-flutuante">
            📚 Acessar as Regras
        </a>
    </div>

    <div class="mt-5">
        <a href="https://loja.campolimporp.com.br"
               class="btn btn-primary btn-lg btn-flutuante">
            🛒 Acessar a Loja
        </a>
    </div>

    <div class="mt-5">
        <a asp-page="/Privacidade" class="btn btn-primary btn-lg btn-flutuante">
            📜 Privacidade
        </a>
    </div>

    <div class="mt-5">
        <a asp-page="/Termos" class="btn btn-primary btn-lg btn-flutuante">
            📃 Termos de Serviços
        </a>
    </div>
</div>
